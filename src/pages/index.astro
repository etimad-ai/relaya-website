---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import '../styles/landing.css';
import mark from '../assets/mark.svg';

const title = 'Relaya — the AI-native CRM that builds itself';
const description =
  'Relaya turns your real customer communications into evidence-grounded memory, explainable deal health, and governed agents with human approval.';
const docs = '/docs/introduction';
const signIn = 'https://app.relayahq.com/login';
const pilot =
  'mailto:support@relayahq.com?subject=Relaya%20private%20pilot&body=Hi%20Relaya%20team%2C%0A%0AI%27d%20like%20to%20learn%20more%20about%20the%20private%20pilot.%0A%0ACompany%3A%0ATeam%20size%3A%0ACurrent%20CRM%3A%0A';

const steps = [
  {
    name: 'Connect',
    body: 'Link Gmail, Outlook, and your calendar over OAuth. Relaya reads the conversations you already have — no manual data entry to get started.',
    tag: 'email · calendar',
  },
  {
    name: 'Remember',
    body: 'Every message and meeting becomes structured memory: commitments, objections, buying signals — each one tied to the exact quote it came from.',
    tag: 'evidence-grounded',
  },
  {
    name: 'Understand',
    body: 'Memory and activity become signals, an explainable deal-health score, and ranked next-best-actions. Never an opaque number — always the why.',
    tag: 'explainable',
  },
  {
    name: 'Act',
    body: 'Agents draft follow-ups and prepare briefings from the evidence. Consequential actions wait for your approval before anything leaves the building.',
    tag: 'human-approved',
  },
];

const features = [
  {
    title: 'Evidence-grounded memory',
    body: 'Each remembered fact carries its source quote, a confidence, and whether it was observed or inferred. Confirm, correct, or reject — the record stays honest.',
  },
  {
    title: 'Explainable deal health',
    body: 'A deal-health score you can defend in a forecast review: the contributing signals, the weighting, and the evidence behind each one, laid out in the open.',
  },
  {
    title: 'Governed agents',
    body: 'Agents propose; you dispose. Every external action goes through a Propose → Approve → Execute → Receipt gate, with an immutable receipt for what happened.',
  },
  {
    title: 'Real connectors',
    body: 'Gmail and Outlook for mail — sync and send — plus Google and Microsoft calendars. Approved sends use provider-side idempotency and recorded receipts to guard against duplicates.',
  },
  {
    title: 'Multi-workspace by design',
    body: 'Invite teammates by role, switch between workspaces, and keep every tenant strictly isolated at the database with forced row-level security.',
  },
  {
    title: 'Your data stays yours',
    body: 'Sign in with your own identity provider — no passwords stored. Connected mailboxes are encrypted, and you can disconnect or delete your data whenever you choose.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://relayahq.com/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href="https://relayahq.com/" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Relaya',
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web',
        description,
        url: 'https://relayahq.com/',
      })}
    />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav__inner">
        <a class="brand" href="/">
          <img class="brand__mark" src={mark.src} alt="" width="26" height="26" />
          Relaya
        </a>
        <span class="nav__spacer"></span>
        <div class="nav__cta">
          <a class="nav__signin" href={signIn}>Sign in</a>
          <a class="btn btn--primary" href={pilot}>Request pilot</a>
        </div>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="hero">
        <div class="wrap">
          <span class="hero__badge">
            <b>Private pilot</b> · for B2B commercial teams
          </span>
          <h1>Know what changed in every deal.</h1>
          <p class="hero__lead">
            Relaya turns email and meetings into evidence-backed customer memory, explainable deal
            health, and the next action to take. You confirm what becomes record; nothing is sent
            without approval.
          </p>
          <div class="hero__cta">
            <a class="btn btn--primary" href={pilot}>Request pilot</a>
            <a class="btn btn--ghost" href="#evidence-flow">See the evidence flow</a>
          </div>
          <div class="hero__trust" aria-label="Trust and product information">
            <a href="/docs/trust/security">Security</a>
            <a href="/docs/trust/privacy">Privacy</a>
            <a href="/docs/trust/data">Data handling</a>
            <a href={docs}>Product docs</a>
          </div>
        </div>
      </section>

      <!-- Evidence-to-action map -->
      <section class="section proof" id="evidence-flow">
        <div class="wrap">
          <div class="proof__intro">
            <div>
              <p class="proof__label">An illustrative interaction</p>
              <h2>From one customer message to the next responsible move.</h2>
            </div>
            <p>
              Relaya keeps the source, interpretation, and proposed response distinct. You can
              inspect the reasoning before anything changes or leaves your workspace.
            </p>
          </div>

          <div class="evidence-map">
            <article class="evidence-source">
              <div class="evidence-source__meta">
                <span>Email</span>
                <span>Customer · 09:42</span>
              </div>
              <blockquote>
                “We’re aligned on scope. Procurement still needs the revised pricing by Friday.”
              </blockquote>
              <p>Original interaction retained as evidence</p>
            </article>

            <ol class="reasoning-path" aria-label="How Relaya turns evidence into a governed action">
              <li class="reasoning-node reasoning-node--observed">
                <span class="reasoning-node__type">Observed fact</span>
                <h3>Revised pricing requested by Friday.</h3>
                <p>Directly supported by the customer’s words.</p>
              </li>
              <li class="reasoning-node reasoning-node--inferred">
                <span class="reasoning-node__type">AI inference</span>
                <h3>Commercial approval may be the current blocker.</h3>
                <p>A hypothesis—not stored or displayed as confirmed truth.</p>
              </li>
              <li class="reasoning-node reasoning-node--recommended">
                <span class="reasoning-node__type">Recommendation</span>
                <h3>Engage procurement before another proposal revision.</h3>
                <p>Ranked against the evidence and current deal state.</p>
              </li>
              <li class="reasoning-node reasoning-node--approval">
                <span class="reasoning-node__type">Approval required</span>
                <h3>Prepare a pricing follow-up for review.</h3>
                <p>Nothing is sent until a person approves the final draft.</p>
              </li>
            </ol>
          </div>

          <div class="proof__legend" aria-label="Evidence map legend">
            <span><i class="legend-dot legend-dot--observed"></i> sourced</span>
            <span><i class="legend-dot legend-dot--inferred"></i> inferred</span>
            <span><i class="legend-dot legend-dot--recommended"></i> recommended</span>
            <span><i class="legend-dot legend-dot--approval"></i> human-controlled</span>
          </div>
        </div>
      </section>

      <!-- Problem -->
      <section class="section">
        <div class="wrap problem">
          <p class="problem__lead">
            A CRM is only as good as what someone remembers to type into it. So most of the
            relationship <span class="accent">never makes it in.</span>
          </p>
          <div class="problem__body">
            <p>
              The context that decides a deal — the objection raised on a call, the timeline slipping
              in an email thread, the competitor mentioned in passing — lives in your inbox and your
              calendar, not your CRM. Reps don't have time to transcribe it, and managers forecast
              on a picture that's always a week stale.
            </p>
            <p>
              Relaya inverts that. It treats your real communications as the source of truth,
              extracts what matters with its evidence attached, and keeps a human in the loop for
              anything that touches the outside world.
            </p>
          </div>
        </div>
      </section>

      <!-- How it works: pipeline -->
      <section class="section" id="how">
        <div class="wrap">
          <div class="section__head">
            <h2>Four stages, one continuous loop.</h2>
            <p>
              Connect once and the loop runs on its own — new mail and meetings flow through
              extraction and intelligence automatically, so what you see is always current.
            </p>
          </div>
          <ol class="pipeline">
            {
              steps.map((s, i) => (
                <li class="step">
                  <h3>{s.name}</h3>
                  <p>{s.body}</p>
                  <span class="step__tag">{s.tag}</span>
                  {i < steps.length - 1 && (
                    <svg
                      class="step__arrow"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M5 12h14m-6-6 6 6-6 6"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- Feature matrix -->
      <section class="section" id="features">
        <div class="wrap">
          <div class="section__head">
            <h2>Built to be trusted, not just automated.</h2>
            <p>
              Every capability is designed so you can see the reasoning and keep the final call. No
              black boxes, no silent sends.
            </p>
          </div>
          <dl class="capabilities">
            {
              features.map((f, i) => (
                <div class="feature">
                  <dt>
                    <span class="sr-only">{String(i + 1).padStart(2, '0')}. </span>
                    {f.title}
                  </dt>
                  <dd>{f.body}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- Governance / trust band -->
      <section class="section" id="governed">
        <div class="wrap trust">
          <div class="section__head" style="margin-bottom:0;max-width:38ch">
            <h2>The AI works for you — with the brakes on.</h2>
            <p>
              Autonomy without accountability is a liability. Relaya is built the other way around:
              the model proposes, the human approves, and the system keeps the receipts.
            </p>
          </div>
          <ul class="trust__list">
            {
              [
                [
                  'Human approval on every send',
                  'Consequential agent actions wait in an approval queue with the full draft. Nothing leaves without a click.',
                ],
                [
                  'Immutable action receipts',
                  'What was proposed, who approved it, and what the provider returned — recorded and update-protected.',
                ],
                [
                  'Tenant isolation at the database',
                  'Forced row-level security isolates workspaces independently of application-level query logic.',
                ],
                [
                  'Password-less sign-in',
                  'Authenticate through your own identity provider. Relaya never asks for, sees, or stores a password.',
                ],
              ].map(([t, d]) => (
                <li>
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d="M12 3l7 3v5c0 4.4-3 7.5-7 9-4-1.5-7-4.6-7-9V6l7-3Z"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linejoin="round"
                    />
                    <path
                      d="m9 12 2 2 4-4"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <div>
                    <b>{t}</b>
                    <br />
                    <span>{d}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- CTA -->
      <section class="wrap">
        <div class="cta">
          <p class="cta__pilot">Private pilot</p>
          <h2>Bring your inbox. Keep your judgement.</h2>
          <p>
            Tell us where customer context gets lost today. We’ll reply personally to confirm fit,
            answer security questions, and agree the smallest useful pilot.
          </p>
          <div class="cta__row">
            <a class="btn btn--onDeep" href={pilot}>Request pilot</a>
            <a class="btn btn--ghostDeep" href={signIn}>Sign in</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer__top">
          <div class="footer__mast">
            <a class="footer__brand" href="/">
              <img src={mark.src} alt="" width="28" height="28" />
              Relaya
            </a>
            <p>Customer evidence, transformed into governed action.</p>
          </div>
          <div class="footer__links" aria-label="Product and company links">
            <a href="/why">Why Relaya</a>
            <a href="#how">How it works</a>
            <a href={docs}>Docs</a>
            <a href="/docs/trust/security">Trust</a>
            <a href={signIn}>Sign in</a>
          </div>
        </div>
        <div class="footer__bottom">
          <span>© {new Date().getFullYear()} Relaya. All rights reserved.</span>
        </div>
      </div>
    </footer>
  </body>
</html>
