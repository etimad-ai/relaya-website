<script>
  function emailFromHref(href) {
    const m = href.match(/^mailto:([^?]+)/i);
    return m ? decodeURIComponent(m[1]) : '';
  }

  function removeToast() {
    document.querySelectorAll('.pilot-fallback').forEach((el) => el.remove());
  }

  function showToast(address) {
    removeToast();

    const toast = document.createElement('div');
    toast.className = 'pilot-fallback';
    toast.setAttribute('role', 'dialog');
    toast.setAttribute('aria-live', 'polite');
    toast.innerHTML = `
      <div class="pilot-fallback__card">
        <p class="pilot-fallback__title">No email app opened?</p>
        <p class="pilot-fallback__body">
          Write to <b>${address}</b> with the subject "Relaya private pilot", or copy the address
          into your email client.
        </p>
        <div class="pilot-fallback__actions">
          <a class="btn btn--primary" href="mailto:${address}">Open email app</a>
          <button type="button" class="btn btn--ghost" data-copy>Copy address</button>
          <button type="button" class="pilot-fallback__close" aria-label="Close" data-close>&times;</button>
        </div>
      </div>
    `;
    document.body.appendChild(toast);

    toast.querySelector('[data-close]').addEventListener('click', removeToast);
    toast.querySelector('[data-copy]').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(address);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = address;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      const btn = toast.querySelector('[data-copy]');
      btn.textContent = 'Copied';
    });
    toast.addEventListener('click', (e) => {
      if (e.target === toast) removeToast();
    });

    window.setTimeout(() => {
      if (document.body.contains(toast)) removeToast();
    }, 12000);
  }

  document.querySelectorAll('a[href^="mailto:"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const isTouch =
        (navigator.maxTouchPoints && navigator.maxTouchPoints > 0) ||
        window.matchMedia('(pointer: coarse)').matches;

      if (!isTouch) {
        e.preventDefault();
        window.location.href = 'https://nayma.ai/contact';
        return;
      }

      const address = emailFromHref(link.getAttribute('href') || '');
      if (!address) return;
      window.setTimeout(() => showToast(address), 250);
    });
  });
</script>

